# Copy to `.env` in the repository root. Never commit `.env`.
# Both apps/web and apps/scanner read the root `.env`.

# --- Supabase (accounts). Use the publishable key only; see supabase/README.md ---------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key (sb_secret_… or legacy service_role) for report storage and the
# public repository. Read by apps/scanner only. Never expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=

# --- Gemma 4 explanations (backend only) ---------------------------------------------------
# google = Gemma on the Gemini API (key from https://aistudio.google.com/apikey)
# openai_compatible = self-hosted Gemma (Ollama/vLLM/LM Studio) at AI_BASE_URL
AI_PROVIDER=google
AI_MODEL=gemma-4-26b-a4b-it
GOOGLE_AI_API_KEY=

# --- Threat intelligence (optional; OpenPhish needs no key) ---------------------------------
URLHAUS_AUTH_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=

# --- Report registry -----------------------------------------------------------------------
REGISTRY_RPC_URL=http://127.0.0.1:8545
REGISTRY_PUBLIC_RPC_URL=http://127.0.0.1:8545
REGISTRY_CONTRACT_ADDRESS=
# Local Hardhat chain only: Hardhat's public dev account #0 is
#   0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Never use it, or any committed key, on a public network.
REGISTRY_PRIVATE_KEY=

# --- Service wiring ------------------------------------------------------------------------
# The browser does not need a public API or site URL. Local dev calls the scanner on this port.
# Production calls the same origin as the page. The Worker reaches the scanner through SCANNER_ORIGIN.
SCANNER_PORT=8788
# 127.0.0.1 keeps the scanner on this machine. Use 0.0.0.0 when a host must reach it.
SCANNER_HOST=127.0.0.1
# Comma-separated browser origins for direct scanner calls. Use * to allow the caller's origin.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,0.0.0.0

# --- Cloudflare gateway (set these in the Worker settings, not in the site build) ----------
# The domain attached to the Worker is always allowed. To allow extra sites, set ALLOWED_ORIGINS
# on the Worker as a comma-separated list. It is not read from this file.
SCANNER_ORIGIN=
