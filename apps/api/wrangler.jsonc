{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "veriq",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-07",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../web/out",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/v1/*", "/health"]
  }
}
