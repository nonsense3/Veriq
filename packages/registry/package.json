{
  "name": "@veriq/registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Solidity report registry for Veriq, with Hardhat tests and a reproducible local deployment.",
  "scripts": {
    "compile": "hardhat build",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "build": "hardhat build",
    "typecheck": "hardhat build"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@types/node": "^24.10.0",
    "hardhat": "^3.21.2",
    "typescript": "^5.9.3",
    "viem": "^2.57.16"
  }
}
